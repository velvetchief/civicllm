# Database (docker-compose default)
DATABASE_URL=postgresql://civicllm:civicllm-dev@localhost:5433/civicllm

# LLM provider: "anthropic" (Claude Sonnet — hosted/web demo default) or
# "ollama" (private/closed weights — set this for on-prem city deployments).
LLM_PROVIDER=anthropic

# Anthropic (default — powers the hosted/web demo). Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (private/closed deployment — runs on the city's own hardware)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
